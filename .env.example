# Copy this file to .env when you are ready to connect a real LLM API.
# You do NOT need any API key to run with `--provider mock`.

# Option 1: Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Option 2: OpenAI API (or OpenAI-compatible: OpenRouter, Groq, Ollama)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
